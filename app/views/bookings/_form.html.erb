<div class="page-header">
  <div>
    <p class="eyebrow">Booking record</p>
    <h1><%= booking.persisted? ? "Edit #{booking.title}" : "New Booking" %></h1>
  </div>
</div>

<%= render "shared/errors", record: booking %>

<%= form_with model: booking, class: "form", data: {
  controller: "patron-contact",
  confirm_title: "Cancel booking?",
  confirm_message: "Canceling this booking also cancels its scheduled runs and releases the spaces. Continue?",
  confirm_label: "Cancel booking",
  confirm_when_field: "booking[status]",
  confirm_when_value: "canceled"
} do |form| %>
  <section class="form-grid">
    <div>
      <%= form.label :title %>
      <%= form.text_field :title, **accessible_field_options(form, :title, required: true) %>
      <%= field_error form, :title %>
    </div>
    <div>
      <%= form.label :patron_id, "Patron" %>
      <%= form.collection_select :patron_id, Patron.order(:name), :id, :name, { prompt: "Choose a patron" }, required: true, data: { patron_contact_target: "patron", action: "patron-contact#filterContacts" } %>
    </div>
    <div>
      <%= form.label :primary_contact_id, "Primary contact" %>
      <% contact_options = Contact.includes(:patron).order(:last_name, :first_name).map { |contact| ["#{contact.name} (#{contact.patron.name})", contact.id, { data: { patron_id: contact.patron_id } }] } %>
      <%= form.select :primary_contact_id, contact_options, { include_blank: "None" }, accessible_field_options(form, :primary_contact, data: { patron_contact_target: "contact" }) %>
      <%= field_error form, :primary_contact %>
    </div>
    <div>
      <%= form.label :booking_type %>
      <%= form.select :booking_type, Booking.booking_types.keys.map { |key| [key.humanize, key] } %>
    </div>
    <div>
      <%= form.label :status %>
      <%= form.select :status, Booking.statuses.keys.map { |key| [key.humanize, key] } %>
    </div>
    <div>
      <%= form.label :contract_status %>
      <%= form.select :contract_status, Booking.contract_statuses.keys.map { |key| [key.humanize, key] } %>
    </div>
    <div>
      <%= form.label :starts_on %>
      <%= form.date_field :starts_on, **accessible_field_options(form, :starts_on, required: true) %>
      <%= field_error form, :starts_on %>
    </div>
    <div>
      <%= form.label :ends_on %>
      <%= form.date_field :ends_on, **accessible_field_options(form, :ends_on, required: true) %>
      <%= field_error form, :ends_on %>
    </div>
    <div>
      <%= form.label :estimated_attendance %>
      <%= form.number_field :estimated_attendance, **accessible_field_options(form, :estimated_attendance, min: 0) %>
      <%= field_error form, :estimated_attendance %>
    </div>
    <label class="check">
      <%= form.check_box :public_event %>
      Public event
    </label>
  </section>

  <section class="panel" data-controller="nested-form" data-nested-form-item-name-value="Run">
    <div class="section-heading">
      <h2>Runs</h2>
      <button type="button" class="secondary-button" data-nested-form-target="addButton" data-action="nested-form#add">Add run</button>
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-nested-form-target="status"></p>

    <template data-nested-form-target="template">
      <%= form.fields_for :booking_runs, BookingRun.new, child_index: "NEW_RECORD" do |run_fields| %>
        <%= render "run_fields", run_fields: run_fields %>
      <% end %>
    </template>

    <div data-nested-form-target="container">
      <%= form.fields_for :booking_runs do |run_fields| %>
        <%= render "run_fields", run_fields: run_fields %>
      <% end %>
    </div>
  </section>

  <section class="form-grid">
    <div>
      <%= form.label :description %>
      <%= form.text_area :description, rows: 5 %>
    </div>
    <div>
      <%= form.label :internal_notes %>
      <%= form.text_area :internal_notes, rows: 5 %>
    </div>
  </section>

  <div class="form-actions">
    <%= form.submit class: "primary-button" %>
    <%= link_to "Cancel", booking.persisted? ? booking : bookings_path, class: "secondary-button" %>
  </div>
<% end %>
