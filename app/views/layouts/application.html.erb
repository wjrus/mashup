<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "MATCH" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="MATCH">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml" sizes="any">
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="confirmation">
    <a href="#main-content"
       class="skip-link"
       data-controller="skip-link"
       data-action="click->skip-link#skip">Skip to main content</a>

    <% if current_user %>
      <header class="topbar">
        <%= link_to "MATCH Bookings", root_path, class: "brand" %>
        <nav aria-label="Primary navigation">
          <%= link_to "Dashboard", root_path, aria: { current: controller_name == "dashboard" ? "page" : nil } %>
          <%= link_to "Bookings", bookings_path, aria: { current: controller_name.in?(%w[bookings booking_documents]) ? "page" : nil } %>
          <%= link_to "Patrons", patrons_path, aria: { current: controller_name == "patrons" ? "page" : nil } %>
          <%= link_to "Settings", settings_path, aria: { current: (controller_name == "settings" || controller_path.start_with?("admin/")) ? "page" : nil } if current_user.admin? %>
        </nav>
        <details class="account-menu" data-controller="menu">
          <summary aria-label="Account menu" aria-haspopup="menu">
            <% if current_user.avatar_url.present? %>
              <%= image_tag current_user.avatar_url, alt: "", class: "avatar" %>
            <% else %>
              <span class="avatar-fallback" aria-hidden="true"><%= (current_user.name.presence || current_user.email).first.upcase %></span>
            <% end %>
            <span><%= current_user.name.presence || current_user.email %></span>
          </summary>
          <div class="account-menu-panel">
            <div class="account-menu-heading">
              <strong><%= current_user.name.presence || "Signed in" %></strong>
              <span><%= current_user.email %></span>
            </div>
            <div class="account-menu-divider"></div>
            <%= render "shared/theme_picker" %>
            <div class="account-menu-divider"></div>
            <%= button_to "Sign out", logout_path, method: :delete, class: "link-button" %>
          </div>
        </details>
      </header>
    <% end %>

    <main id="main-content" class="page" tabindex="-1">
      <% if notice.present? || alert.present? %>
        <div class="flash-region" aria-live="polite">
          <%= render "shared/flash", kind: :notice, message: notice if notice.present? %>
          <%= render "shared/flash", kind: :alert, message: alert if alert.present? %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <dialog class="confirmation-dialog"
            aria-labelledby="confirmation-title"
            aria-describedby="confirmation-message"
            data-confirmation-target="dialog"
            data-action="click->confirmation#closeFromBackdrop cancel->confirmation#cancel">
      <div class="confirmation-dialog-header">
        <h2 id="confirmation-title" data-confirmation-target="title">Please confirm</h2>
        <button type="button" class="modal-close" aria-label="Close confirmation" data-action="confirmation#cancel">×</button>
      </div>
      <p id="confirmation-message" class="confirmation-dialog-body" data-confirmation-target="message"></p>
      <div class="confirmation-dialog-actions">
        <button type="button" class="secondary-button modal-close" data-action="confirmation#cancel">Cancel</button>
        <button type="button" class="danger-button" data-confirmation-target="confirmButton" data-action="confirmation#confirm">Confirm</button>
      </div>
    </dialog>
  </body>
</html>
