<% content_for :title, "Spaces" %>

<div class="page-header">
  <div>
    <p class="eyebrow">Administration</p>
    <h1>Spaces</h1>
  </div>
  <%= link_to "New space", new_admin_space_path, class: "primary-button" %>
</div>

<div class="table-wrap">
  <table>
    <caption class="sr-only">Spaces</caption>
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Capacity</th>
        <th scope="col">Status</th>
        <th scope="col" class="action-column" aria-label="Actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @spaces.each do |space| %>
        <tr>
          <th scope="row"><%= space.name %></th>
          <td><%= space.capacity || "Not set" %></td>
          <td><span class="pill"><%= space.active? ? "Active" : "Inactive" %></span></td>
          <td class="action-column">
            <div class="table-actions">
              <%= link_to "Edit", edit_admin_space_path(space), class: "secondary-button compact-button", aria: { label: "Edit #{space.name}" } %>
              <%= button_to "Delete", admin_space_path(space), method: :delete,
                class: "secondary-button compact-button danger-link",
                form: { class: "table-action-form" },
                aria: { label: "Delete #{space.name}" },
                data: {
                  confirm_title: "Delete space?",
                  confirm_message: "Delete #{space.name}? This cannot be undone.",
                  confirm_label: "Delete space"
                } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
