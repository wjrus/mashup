<% content_for :title, "Patrons" %>

<div class="page-header">
  <div>
    <p class="eyebrow">People and organizations</p>
    <h1>Patrons</h1>
  </div>
  <%= link_to "New patron", new_patron_path, class: "primary-button" %>
</div>

<div class="table-wrap">
  <table>
    <caption class="sr-only">Patrons</caption>
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Type</th>
        <th scope="col">Status</th>
        <th scope="col">Contact</th>
        <th scope="col" class="action-column" aria-label="Actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @patrons.each do |patron| %>
        <tr>
          <th scope="row"><strong><%= link_to patron.name, patron %></strong></th>
          <td><%= patron.display_type %></td>
          <td><span class="pill"><%= patron.status.delete_prefix("status_").humanize %></span></td>
          <td><%= patron.email.presence || patron.phone.presence || patron.contacts.first&.email %></td>
          <td class="action-column"><%= link_to "Edit", edit_patron_path(patron), aria: { label: "Edit #{patron.name}" } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
