<div class="page-header">
  <div>
    <p class="eyebrow">Patron record</p>
    <h1><%= patron.persisted? ? "Edit #{patron.name}" : "New Patron" %></h1>
  </div>
</div>

<%= render "shared/errors", record: patron %>

<%= form_with model: patron, class: "form" do |form| %>
  <section class="form-grid">
    <div>
      <%= form.label :name %>
      <%= form.text_field :name, **accessible_field_options(form, :name, required: true) %>
      <%= field_error form, :name %>
    </div>
    <div>
      <%= form.label :patron_type %>
      <%= form.select :patron_type, Patron.patron_types.keys.map { |key| [key.humanize, key] } %>
    </div>
    <div>
      <%= form.label :status %>
      <%= form.select :status, Patron.statuses.keys.map { |key| [key.delete_prefix("status_").humanize, key] } %>
    </div>
    <div>
      <%= form.label :email %>
      <%= form.email_field :email %>
    </div>
    <div>
      <%= form.label :phone %>
      <%= form.telephone_field :phone %>
    </div>
    <div>
      <%= form.label :website %>
      <%= form.url_field :website %>
    </div>
  </section>

  <section class="form-grid">
    <div>
      <%= form.label :address_line1 %>
      <%= form.text_field :address_line1 %>
    </div>
    <div>
      <%= form.label :address_line2 %>
      <%= form.text_field :address_line2 %>
    </div>
    <div>
      <%= form.label :city %>
      <%= form.text_field :city %>
    </div>
    <div>
      <%= form.label :state %>
      <%= form.text_field :state %>
    </div>
    <div>
      <%= form.label :postal_code %>
      <%= form.text_field :postal_code %>
    </div>
  </section>

  <section class="panel" data-controller="nested-form" data-nested-form-item-name-value="Contact">
    <div class="section-heading">
      <h2>Contacts</h2>
      <button type="button" class="secondary-button" data-nested-form-target="addButton" data-action="nested-form#add">Add contact</button>
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-nested-form-target="status"></p>

    <template data-nested-form-target="template">
      <%= form.fields_for :contacts, Contact.new, child_index: "NEW_RECORD" do |contact_fields| %>
        <%= render "contact_fields", contact_fields: contact_fields %>
      <% end %>
    </template>

    <div data-nested-form-target="container">
      <%= form.fields_for :contacts do |contact_fields| %>
        <%= render "contact_fields", contact_fields: contact_fields %>
      <% end %>
    </div>
  </section>

  <div>
    <%= form.label :notes %>
    <%= form.text_area :notes, rows: 4 %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "primary-button" %>
    <%= link_to "Cancel", patron.persisted? ? patron : patrons_path, class: "secondary-button" %>
  </div>
<% end %>
